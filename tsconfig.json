{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["DOM", "ES2022"],
		"types": ["node"],
		"strict": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noUncheckedIndexedAccess": true,
		"noFallthroughCasesInSwitch": true,
		"useUnknownInCatchVariables": true,
		"isolatedModules": true,
		"importHelpers": true,
		"skipLibCheck": true,
		"sourceMap": false,
		"allowJs": false,
		"noEmit": true
	},
	"include": ["src/**/*.ts", "tests/**/*.ts"]
}
