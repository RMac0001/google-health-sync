{
	"name": "google-health-sync",
	"version": "0.2.1",
	"description": "Sync Google Health data into your Obsidian vault.",
	"main": "main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit && node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"google-health"
	],
	"license": "GPL-3.0-only",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@eslint/json": "0.14.0",
		"@types/node": "^22.0.0",
		"builtin-modules": "^5.0.0",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.0.0",
		"obsidian": "^1.13.1",
		"prettier": "^3.9.0",
		"tslib": "^2.8.1",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.70.1",
		"vitest": "^5.0.2"
	}
}
